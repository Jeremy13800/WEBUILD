# Copier ce fichier en `.env.local` (jamais commité, voir .gitignore) pour
# activer l'envoi réel des demandes du formulaire de contact.
#
# RESEND_API_KEY et CONTACT_TO_EMAIL sont OBLIGATOIRES : sans elles (ou si
# CONTACT_TO_EMAIL est invalide ou sur un domaine bloqué comme webuild.fr),
# la route refuse tout envoi et le formulaire affiche "temporairement
# indisponible". Il n'existe plus aucun repli mailto: ni destinataire par
# défaut.

# Clé API Resend (https://resend.com/api-keys) — active l'envoi côté serveur
# via src/app/api/contact/route.ts.
RESEND_API_KEY=

# Adresse qui reçoit les demandes (variable serveur, jamais exposée au
# navigateur). Plusieurs adresses possibles, séparées par des virgules.
CONTACT_TO_EMAIL=

# Adresse expéditrice affichée par Resend. Doit appartenir à un domaine
# vérifié dans votre compte Resend — sinon garder la valeur de test
# "onboarding@resend.dev" fournie par défaut dans le code.
CONTACT_FROM_EMAIL=
